# Copy to .env and fill in. Never commit .env.

# Postgres connection string (Neon / Supabase dashboard -> "Connection string")
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required when NODE_ENV=production.
JWT_SECRET=

PORT=3000

CORS_ORIGINS=https://frontend-placeholder.example.com

# Optional. Keep uploaded images, PDFs and videos on Cloudinary instead of this server's disk.
# Copy the value from the Cloudinary dashboard: cloudinary://API_KEY:API_SECRET@CLOUD_NAME   (never commit it)
# CLOUDINARY_URL=
# Optional. Top-level Cloudinary folder (default moneyguard); files go in <folder>/<userId>.
# CLOUDINARY_FOLDER=moneyguard

# AI assistant (POST /api/assistant), run by Ollama. Without OLLAMA_MODEL the endpoint answers 503 and everything else works.
# The model must support tool calling (for example llama3.1 or qwen2.5).
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=            # only for a protected or cloud Ollama server
# OLLAMA_TIMEOUT_MS=60000

# Optional. Access token lifetime in seconds (default 3600 = 1 hour) and refresh token lifetime in days (default 7).
# ACCESS_TOKEN_SECONDS=3600
# REFRESH_TOKEN_DAYS=7

# Optional. Max ms to wait for a database connection (default 5000). A hosted database in another
# region can take 2-8s to accept a secure connection; raise it to 20000 for local development against one.
# DB_CONNECT_TIMEOUT_MS=20000

# Optional. Without it rate limits and idempotency use in-memory storage (single instance only).
# REDIS_URL=redis://localhost:6379

# Number of reverse proxies in front of the app (1 behind most load balancers / hosting platforms).
# TRUST_PROXY=1
